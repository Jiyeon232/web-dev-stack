<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kh.upload.mapper.BoardMapper">
	<resultMap id="boardMap" type="Board">
		<id property="no" column="no"/>
		<result property="title" column="title"/>
		<result property="content" column="content"/>
		<result property="url" column="url"/>
		<result property="createdAt" column="created_at"/>
	</resultMap>
	
	<insert id="insertBoard" parameterType="Board" useGeneratedKeys="true" keyProperty="no" keyColumn="no">
		INSERT INTO board(title, content, url) 
		VALUES(#{title}, #{content}, #{url})
	</insert>
	
	<select id="selectBoard" parameterType="PagingDTO" resultMap="boardMap">
		SELECT * FROM board 
		<where>
			<if test="keyword != null">
				title LIKE CONCAT('%' #{keyword} '%')
			</if>
		</where>
		LIMIT #{offset}, #{limit}
	</select>
	
	<select id="page" parameterType="String" resultType="int">
		SELECT count(*) FROM board
		<where>
			<if test="keyword != null">
				title LIKE CONCAT('%' #{keyword} '%')
			</if>
		</where>
	</select>
	
	<select id="searchBoard" parameterType="int" resultMap="boardMap">
		SELECT * FROM board 
		WHERE no = #{no}
	</select>
	
	<update id="updateBoard" parameterType="BoardDTO">
		UPDATE board
		SET title = #{title},
			content = #{content},
			url = #{url}
		WHERE no = #{no}
	</update>
	
	<delete id="deleteBoard" parameterType="int">
		DELETE FROM board 
		WHERE no = #{no}
	</delete>
</mapper>